@echo off
echo ==========================================
echo  CONFIGURACION LOCAL ERP - 8AMPERIOS
echo ==========================================

REM Verificar que estamos en la carpeta correcta
if not exist "manage.py" (
    echo ERROR: No se encontro manage.py. Ejecuta este script desde la raiz del proyecto.
    pause
    exit /b 1
)

REM 1. Crear frontend/.env.local
echo Creando frontend/.env.local...
echo VITE_API_URL=http://localhost:8000/api/ > frontend\.env.local
echo [OK] frontend/.env.local creado

REM 2. Crear .env en raiz
echo Creando .env...
(
    echo DEBUG=True
    echo USE_S3=False
    echo SECRET_KEY=django-insecure-8amp-local-dev-key-fallback
) > .env
echo [OK] .env creado

REM 3. Verificar que media serving esta en urls.py
findstr /C:"urlpatterns += static" erp_core\urls.py >nul
if %errorlevel% == 0 (
    echo [OK] Media serving ya configurado en erp_core/urls.py
) else (
    echo [ADVERTENCIA] No se encontro media serving en erp_core/urls.py
)

echo.
echo ==========================================
echo  CONFIGURACION COMPLETADA
echo ==========================================
echo.
echo Ahora reinicia ambos servidores:
echo.
echo  1. Backend:  python manage.py runserver
echo  2. Frontend: cd frontend ^&^& npm run dev
echo.
pause
